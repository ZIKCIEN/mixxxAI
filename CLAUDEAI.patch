diff --git a/src/test/latenightlayoutstate_test.cpp b/src/test/latenightlayoutstate_test.cpp
index 4a4469b..b512ed3 100644
--- a/src/test/latenightlayoutstate_test.cpp
+++ b/src/test/latenightlayoutstate_test.cpp
@@ -35,6 +35,23 @@ class LateNightLayoutStateTest : public MixxxTest {
         return std::unique_ptr<QObject>(object);
     }
 
+    std::unique_ptr<QObject> createSectionPane(bool shown, qreal contentHeight, qreal userHeight = 0) {
+        QQmlComponent component(
+                &m_engine,
+                QUrl::fromLocalFile(QStringLiteral(
+                        RESOURCE_FOLDER "/skins/LateNightQML/Controls/SectionPane.qml")));
+        QVariantMap initialProperties{
+                {QStringLiteral("animationEnabled"), false},
+                {QStringLiteral("contentHeight"), contentHeight},
+                {QStringLiteral("shown"), shown},
+                {QStringLiteral("userHeight"), userHeight},
+        };
+        QObject* object = component.createWithInitialProperties(initialProperties);
+        EXPECT_FALSE(component.isError()) << qPrintable(component.errorString());
+        EXPECT_NE(nullptr, object);
+        return std::unique_ptr<QObject>(object);
+    }
+
     QQmlEngine m_engine;
 };
 
@@ -144,4 +161,40 @@ Item {
     EXPECT_EQ(QStringLiteral("cue_set"), object->property("rightClickKey").toString());
 }
 
+TEST_F(LateNightLayoutStateTest, SectionPaneNeverShrinksBelowItsContent) {
+    auto pane = createSectionPane(true, 80);
+    ASSERT_TRUE(pane);
+    EXPECT_DOUBLE_EQ(80, pane->property("paneMinimumHeight").toDouble());
+    EXPECT_DOUBLE_EQ(80, pane->property("panePreferredHeight").toDouble());
+    EXPECT_TRUE(pane->property("visible").toBool());
+
+    // A height smaller than the content is ignored.
+    pane->setProperty("userHeight", 50);
+    EXPECT_DOUBLE_EQ(80, pane->property("panePreferredHeight").toDouble());
+}
+
+TEST_F(LateNightLayoutStateTest, SectionPaneKeepsUserHeightAndCanBeHidden) {
+    auto pane = createSectionPane(true, 80, 150);
+    ASSERT_TRUE(pane);
+    EXPECT_DOUBLE_EQ(80, pane->property("paneMinimumHeight").toDouble());
+    EXPECT_DOUBLE_EQ(150, pane->property("panePreferredHeight").toDouble());
+
+    pane->setProperty("shown", false);
+    EXPECT_DOUBLE_EQ(0, pane->property("paneMinimumHeight").toDouble());
+    EXPECT_DOUBLE_EQ(0, pane->property("panePreferredHeight").toDouble());
+    EXPECT_FALSE(pane->property("visible").toBool());
+
+    // The height chosen by the user is restored when the pane is shown again.
+    pane->setProperty("shown", true);
+    EXPECT_DOUBLE_EQ(150, pane->property("panePreferredHeight").toDouble());
+}
+
+TEST_F(LateNightLayoutStateTest, SectionPaneFollowsContentHeight) {
+    auto pane = createSectionPane(true, 80);
+    ASSERT_TRUE(pane);
+    pane->setProperty("contentHeight", 120);
+    EXPECT_DOUBLE_EQ(120, pane->property("paneMinimumHeight").toDouble());
+    EXPECT_DOUBLE_EQ(120, pane->property("panePreferredHeight").toDouble());
+}
+
 } // namespace
