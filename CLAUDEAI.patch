new file mode 100644
index 0000000..caf9023
--- /dev/null
+++ b/res/skins/LateNightQML/Controls/SectionPane.qml
@@ -0,0 +1,67 @@
+import "../LateNightTheme"
+import ".." as LateNight
+import QtQuick
+import QtQuick.Controls
+
+// A section of the main window embedded as a resizable pane of the main
+// vertical SplitView (no separate native window).
+//
+// The pane never gets smaller than its content (no hidden controls), and can
+// be enlarged with the splitter handle that follows it. The height chosen by
+// the user is remembered while the pane is hidden and shown again.
+Rectangle {
+    id: root
+
+    // Items declared inside the pane are placed in the clipped content area.
+    default property alias content: contentArea.data
+
+    property bool animationEnabled: LateNightTheme.layoutAnimationsEnabled
+    property int animationDuration: 180
+    // Natural height of the content: the minimum height of the pane.
+    property real contentHeight: 0
+    property bool shown: true
+    // Bound to SplitView.resizing of the parent SplitView.
+    property bool splitterResizing: false
+    // Height set by the user with the splitter handle (0: follow content).
+    property real userHeight: 0
+
+    readonly property bool animating: minimumHeightAnimation.running || preferredHeightAnimation.running
+    readonly property real paneMinimumHeight: minimumHeightAnimation.value
+    readonly property real panePreferredHeight: preferredHeightAnimation.value
+
+    SplitView.minimumHeight: paneMinimumHeight
+    clip: true
+    implicitHeight: panePreferredHeight
+    visible: panePreferredHeight > 0
+
+    Component.onCompleted: SplitView.preferredHeight = panePreferredHeight
+    onHeightChanged: {
+        if (shown && splitterResizing)
+            userHeight = Math.max(height, contentHeight);
+    }
+    onPanePreferredHeightChanged: {
+        if (!splitterResizing)
+            SplitView.preferredHeight = panePreferredHeight;
+    }
+
+    LateNight.LayoutAnimation {
+        id: minimumHeightAnimation
+
+        animationEnabled: root.animationEnabled && !root.splitterResizing
+        duration: root.animationDuration
+        targetValue: root.shown ? root.contentHeight : 0
+    }
+    LateNight.LayoutAnimation {
+        id: preferredHeightAnimation
+
+        animationEnabled: root.animationEnabled && !root.splitterResizing
+        duration: root.animationDuration
+        targetValue: root.shown ? Math.max(root.userHeight, root.contentHeight) : 0
+    }
+    Item {
+        id: contentArea
+
+        height: root.contentHeight
+        width: parent.width
+    }
+}
